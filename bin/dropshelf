#!/usr/bin/python3
"""Drop Shelf's hands: the state file, what staged paths are now, and delivery.

Usage: dropshelf state read  <file>
       dropshelf state write <file>   (the new content arrives on stdin)
       dropshelf inspect              (a JSON array of paths on stdin)
       dropshelf deliver              ({"target", "mode", "items"} on stdin)
       dropshelf send                 ({"host", "dir", "mode", "items"} on stdin)
       dropshelf hosts                (SSH host aliases from ~/.ssh/config)
       dropshelf open-folder          ({"folder", "items"} on stdin)

Paths only ever arrive on stdin: other local users can read a running
process's arguments in /proc/<pid>/cmdline, and file names are private.

state: the shell never opens a file itself. This works on open directories,
not path names: $HOME, then each component below it, opened one at a time
relative to the one above with O_NOFOLLOW|O_DIRECTORY and checked with fstat
(owned by this user, not writable by group or others). The file is opened
relative to that descriptor with O_NOFOLLOW|O_NONBLOCK, must be a regular
file this user owns, and is replaced through an O_EXCL temp file renamed
relative to the same descriptor.

inspect: one JSON array back, one entry per path: what sits there now
(file, folder, link, other or missing) and, for a file, its size. Nothing is
followed and nothing is opened.

deliver: copies or moves every item into the target folder. The target is
opened once, must be a folder this user owns, and everything is created
relative to that descriptor with O_CREAT|O_EXCL|O_NOFOLLOW (folders with
mkdirat, links with symlinkat). Nothing that already exists is overwritten
or followed: a taken name becomes "name (2).ext", and so on. A move is a
rename that refuses to replace (renameat2 RENAME_NOREPLACE); across file
systems it is a full copy, then the source is removed only if it is still
the same file or folder that was copied. Links inside copied folders are
copied as links, never followed; sockets, FIFOs and devices are skipped.
Mode "zip" packs everything into one new archive in the target instead
("name.zip" for one item, "<host>-<date>-<time>.zip" for several, never
overwriting);
links inside folders are skipped, never followed.
Output is one JSON object per line: progress, one result per item, then
done. SIGTERM stops the current item, removes what it had written so far,
and leaves every source untouched.

send: copies or moves the items into a folder on an SSH host. The items go
as one tar stream on ssh's stdin, preceded by the folder on its own line, so
neither file names nor the folder appear in any argument list. The remote
side is a fixed sh script (no values are ever spliced into it): it unpacks
into a private temporary folder inside the target, then puts each item in
place with "mv -n" under the first free name, exactly like a local delivery,
and reports one line per item. A move removes a local original only after
the remote side reported that item in place, and only if it is still the
same file or folder that was sent. The stream is built from descriptors:
every file and folder is opened with O_NOFOLLOW relative to the folder it
sits in, checked with fstat, and read through that descriptor, so nothing
swapped in under a name after it was looked at is ever read. The host
folder must belong to the user and not be writable by group or others. Mode "zip" builds the archive in a
private 0700 folder under ~/.cache/dropshelf first, sends that one file,
and removes the folder whatever happens. Text from the host is stripped of
colour codes and control characters before it is reported. Needs sh, tar and mv on the host (Linux
or macOS). The host must be a plain alias; ssh runs with BatchMode, so it
never stops to ask anything.

hosts: the concrete Host aliases in ~/.ssh/config (and files it Includes),
leaving out patterns and hosts whose User is git.

open-folder: shows the folder in the file manager over D-Bus
(org.freedesktop.FileManager1), selecting the delivered items when given.

Exit 0 on success (deliver also exits 0 when some items failed; the lines
say which), 3 when a check refused the request, 1 on a usage error, 130
when cancelled.
"""
import ctypes
import glob
import json
import re
import os
import secrets
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tarfile
import threading
import time
import zipfile

NAME = "dropshelf"
MAX_STATE_BYTES = 512 * 1024
MAX_INPUT_BYTES = 2 * 1024 * 1024
MAX_ITEMS = 200
MAX_PATH = 4096
MAX_DEPTH = 256
MAX_WALK_ENTRIES = 200_000
MAX_NAME_TRIES = 1000
CHUNK = 1 << 20
PROGRESS_EVERY = 0.25
DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
RENAME_NOREPLACE = 1
_old_umask = os.umask(0)
os.umask(_old_umask)
UMASK = _old_umask  # copies get the source's mode minus this, like cp without -p


class Refused(Exception):
    pass


class Cancelled(BaseException):
    pass


def refuse(why):
    print(f"{NAME}: {why}", file=sys.stderr)
    sys.exit(3)


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def read_stdin_json(limit=MAX_INPUT_BYTES):
    data = sys.stdin.buffer.read(limit + 1)
    if len(data) > limit:
        refuse("input larger than the limit")
    try:
        return json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        refuse("input is not JSON")


def clean_path(value):
    """An absolute, plain path, or None."""
    if not isinstance(value, str) or not value.startswith("/") or len(value) > MAX_PATH:
        return None
    if "\0" in value or "\n" in value:
        return None
    path = os.path.normpath(value)
    if path == "/" or os.path.basename(path) in ("", ".", ".."):
        return None
    return path


# ---- state --------------------------------------------------------------------

def check_open_dir(fd, label, uid):
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode):
        refuse(f"{label} is not a directory")
    if st.st_uid != uid:
        refuse(f"{label} is not owned by this user")
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        refuse(f"{label} is writable by others")


def open_state_dir(directory):
    """An open, checked descriptor for `directory`, reached from $HOME."""
    uid = os.getuid()
    home = os.path.realpath(os.path.expanduser("~"))
    directory = os.path.abspath(directory)
    if not directory.startswith(home + os.sep):
        refuse(f"{directory} is outside the home directory")
    try:
        fd = os.open(home, DIR_FLAGS)
    except OSError as error:
        refuse(f"home directory: {error.strerror}")
    label = home
    try:
        check_open_dir(fd, label, uid)
        for part in directory[len(home):].strip(os.sep).split(os.sep):
            if part in ("", ".", ".."):
                refuse(f"{directory} is not a plain path")
            label = os.path.join(label, part)
            try:
                child = os.open(part, DIR_FLAGS, dir_fd=fd)
            except FileNotFoundError:
                try:
                    os.mkdir(part, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
                try:
                    child = os.open(part, DIR_FLAGS, dir_fd=fd)
                except OSError as error:
                    refuse(f"{label}: {error.strerror}")
            except OSError as error:
                # ELOOP: a symlink; ENOTDIR: something else sits there.
                refuse(f"{label}: {error.strerror}")
            os.close(fd)
            fd = child
            check_open_dir(fd, label, uid)
    except BaseException:
        os.close(fd)
        raise
    return fd


def open_regular(name, flags, dir_fd):
    fd = os.open(name, flags | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dir_fd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            refuse(f"{name} is not a regular file")
        if st.st_uid != os.getuid():
            refuse(f"{name} is not owned by this user")
        if st.st_size > MAX_STATE_BYTES:
            refuse(f"{name} is larger than {MAX_STATE_BYTES} bytes")
    except BaseException:
        os.close(fd)
        raise
    return fd


def state_read(path):
    dir_fd = open_state_dir(os.path.dirname(path))
    name = os.path.basename(path)
    try:
        try:
            fd = open_regular(name, os.O_RDONLY, dir_fd)
        except FileNotFoundError:
            sys.stdout.write("{}\n")
            return 0
        except OSError as error:
            refuse(f"{path}: {error.strerror}")
        with os.fdopen(fd, "rb") as handle:
            data = handle.read(MAX_STATE_BYTES + 1)
    finally:
        os.close(dir_fd)
    if len(data) > MAX_STATE_BYTES:
        refuse(f"{path} grew past {MAX_STATE_BYTES} bytes")
    sys.stdout.write(data.decode("utf-8", "replace"))
    if not data.endswith(b"\n"):
        sys.stdout.write("\n")
    return 0


def state_write(path):
    content = sys.stdin.buffer.read(MAX_STATE_BYTES + 1)
    if len(content) > MAX_STATE_BYTES:
        refuse("content larger than the state file limit")
    if not content.endswith(b"\n"):
        content += b"\n"
    dir_fd = open_state_dir(os.path.dirname(path))
    name = os.path.basename(path)
    try:
        try:
            os.close(open_regular(name, os.O_RDONLY, dir_fd))
        except FileNotFoundError:
            pass
        except OSError as error:
            refuse(f"{path}: {error.strerror}")
        tmp = f".dropshelf-{secrets.token_hex(8)}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=dir_fd)
        try:
            with os.fdopen(fd, "wb") as handle:
                handle.write(content)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
            os.fsync(dir_fd)
        except BaseException:
            try:
                os.unlink(tmp, dir_fd=dir_fd)
            except OSError:
                pass
            raise
    finally:
        os.close(dir_fd)
    return 0


# ---- inspect ------------------------------------------------------------------

def kind_of(mode):
    if stat.S_ISREG(mode):
        return "file"
    if stat.S_ISDIR(mode):
        return "folder"
    if stat.S_ISLNK(mode):
        return "link"
    return "other"


def inspect():
    paths = read_stdin_json()
    if not isinstance(paths, list) or len(paths) > MAX_ITEMS:
        refuse(f"expected a list of at most {MAX_ITEMS} paths")
    out = []
    for value in paths:
        path = clean_path(value)
        if path is None:
            out.append({"path": value if isinstance(value, str) else "", "kind": "invalid", "size": -1})
            continue
        try:
            st = os.lstat(path)
        except OSError:
            out.append({"path": path, "kind": "missing", "size": -1})
            continue
        kind = kind_of(st.st_mode)
        out.append({"path": path, "kind": kind, "size": st.st_size if kind == "file" else -1})
    sys.stdout.write(json.dumps(out) + "\n")
    return 0


# ---- deliver ------------------------------------------------------------------

_libc = ctypes.CDLL(None, use_errno=True)
_renameat2 = getattr(_libc, "renameat2", None)
if _renameat2 is not None:
    _renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    _renameat2.restype = ctypes.c_int


def rename_noreplace(src_dir_fd, src_name, dst_dir_fd, dst_name):
    if _renameat2 is None:
        raise OSError(22, "renameat2 is unavailable")
    if _renameat2(src_dir_fd, os.fsencode(src_name), dst_dir_fd, os.fsencode(dst_name), RENAME_NOREPLACE) != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))


def candidates(name, is_dir):
    """name, then "name (2).ext", "name (3).ext", ..."""
    yield name
    stem, ext = name, ""
    if not is_dir:
        lower = name.lower()
        for double in (".tar.gz", ".tar.bz2", ".tar.xz", ".tar.zst"):
            if lower.endswith(double) and len(name) > len(double):
                stem, ext = name[:-len(double)], name[-len(double):]
                break
        else:
            base, dot_ext = os.path.splitext(name)
            if base:
                stem, ext = base, dot_ext
    for n in range(2, MAX_NAME_TRIES + 1):
        yield f"{stem} ({n}){ext}"


class Progress:
    def __init__(self, total):
        self.total = total
        self.done = 0
        self.last = 0.0

    def add(self, count):
        self.done += count
        now = time.monotonic()
        if now - self.last >= PROGRESS_EVERY:
            self.last = now
            emit({"type": "progress", "bytes": self.done, "total": self.total})


def tree_size(path):
    """Bytes under `path`, without following links; -1 past the walk budget."""
    total, seen = 0, 0
    stack = [path]
    while stack:
        current = stack.pop()
        try:
            st = os.lstat(current)
        except OSError:
            continue
        seen += 1
        if seen > MAX_WALK_ENTRIES:
            return -1
        if stat.S_ISREG(st.st_mode):
            total += st.st_size
        elif stat.S_ISDIR(st.st_mode):
            try:
                with os.scandir(current) as entries:
                    stack.extend(entry.path for entry in entries)
            except OSError:
                continue
    return total


def copy_file_data(src_fd, dst_fd, progress):
    while True:
        try:
            count = os.copy_file_range(src_fd, dst_fd, CHUNK)
        except OSError:
            count = None
        if count is None:
            chunk = os.read(src_fd, CHUNK)
            if not chunk:
                return
            view = memoryview(chunk)
            while view:
                written = os.write(dst_fd, view)
                view = view[written:]
            progress.add(len(chunk))
            continue
        if count == 0:
            return
        progress.add(count)


def same_file(st, expect):
    """Refuse when what was opened is not what was looked at."""
    if expect is not None and (st.st_dev, st.st_ino) != expect:
        raise Refused("changed while being delivered")


def copy_file(src_dir_fd, src_name, dst_dir_fd, names, progress, expect=None):
    """Copy one regular file to the first free name; returns the name used."""
    src_fd = os.open(src_name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=src_dir_fd)
    try:
        st = os.fstat(src_fd)
        if not stat.S_ISREG(st.st_mode):
            raise Refused("not a regular file")
        same_file(st, expect)
        for candidate in names:
            try:
                dst_fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                                 0o600, dir_fd=dst_dir_fd)
            except FileExistsError:
                continue
            try:
                copy_file_data(src_fd, dst_fd, progress)
                os.fchmod(dst_fd, stat.S_IMODE(st.st_mode) & 0o777 & ~UMASK)
                os.utime(dst_fd, ns=(st.st_atime_ns, st.st_mtime_ns))
            except BaseException:
                os.close(dst_fd)
                try:
                    os.unlink(candidate, dir_fd=dst_dir_fd)
                except OSError:
                    pass
                raise
            os.close(dst_fd)
            return candidate
        raise Refused("no free name in the target folder")
    finally:
        os.close(src_fd)


def copy_link(src_dir_fd, src_name, dst_dir_fd, names):
    target = os.readlink(src_name, dir_fd=src_dir_fd)
    for candidate in names:
        try:
            os.symlink(target, candidate, dir_fd=dst_dir_fd)
        except FileExistsError:
            continue
        return candidate
    raise Refused("no free name in the target folder")


def copy_tree_into(src_fd, dst_fd, progress, depth, skipped):
    if depth > MAX_DEPTH:
        raise Refused("folders nested too deep")
    with os.scandir(src_fd) as entries:
        listing = list(entries)
    for entry in listing:
        st = entry.stat(follow_symlinks=False)
        if stat.S_ISREG(st.st_mode):
            copy_file(src_fd, entry.name, dst_fd, [entry.name], progress, (st.st_dev, st.st_ino))
        elif stat.S_ISLNK(st.st_mode):
            copy_link(src_fd, entry.name, dst_fd, [entry.name])
        elif stat.S_ISDIR(st.st_mode):
            os.mkdir(entry.name, 0o700, dir_fd=dst_fd)
            child_src = os.open(entry.name, DIR_FLAGS, dir_fd=src_fd)
            try:
                same_file(os.fstat(child_src), (st.st_dev, st.st_ino))
                child_dst = os.open(entry.name, DIR_FLAGS, dir_fd=dst_fd)
                try:
                    copy_tree_into(child_src, child_dst, progress, depth + 1, skipped)
                    os.fchmod(child_dst, stat.S_IMODE(st.st_mode) & 0o777 & ~UMASK)
                    os.utime(child_dst, ns=(st.st_atime_ns, st.st_mtime_ns))
                finally:
                    os.close(child_dst)
            finally:
                os.close(child_src)
        else:
            skipped.append(entry.name)


def copy_folder(src_dir_fd, src_name, dst_dir_fd, names, progress, skipped, expect=None):
    src_fd = os.open(src_name, DIR_FLAGS, dir_fd=src_dir_fd)
    try:
        st = os.fstat(src_fd)
        same_file(st, expect)
        for candidate in names:
            try:
                os.mkdir(candidate, 0o700, dir_fd=dst_dir_fd)
            except FileExistsError:
                continue
            try:
                dst_fd = os.open(candidate, DIR_FLAGS, dir_fd=dst_dir_fd)
                try:
                    copy_tree_into(src_fd, dst_fd, progress, 1, skipped)
                    os.fchmod(dst_fd, stat.S_IMODE(st.st_mode) & 0o777 & ~UMASK)
                    os.utime(dst_fd, ns=(st.st_atime_ns, st.st_mtime_ns))
                finally:
                    os.close(dst_fd)
            except BaseException:
                try:
                    shutil.rmtree(candidate, dir_fd=dst_dir_fd)
                except OSError:
                    pass
                raise
            return candidate
        raise Refused("no free name in the target folder")
    finally:
        os.close(src_fd)


def copy_entry(kind, parent_fd, name, target_fd, progress, skipped, expect=None):
    names = candidates(name, kind == "folder")
    if kind == "file":
        return copy_file(parent_fd, name, target_fd, names, progress, expect)
    if kind == "folder":
        return copy_folder(parent_fd, name, target_fd, names, progress, skipped, expect)
    return copy_link(parent_fd, name, target_fd, names)


def remove_entry(kind, parent_fd, name):
    if kind == "folder":
        shutil.rmtree(name, dir_fd=parent_fd)
    else:
        os.unlink(name, dir_fd=parent_fd)


def deliver_one(path, mode, target_fd, target_real, target_st, progress):
    """(destination name, note) for one item; raises Refused or OSError."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        raise Refused("no longer there")
    kind = kind_of(st.st_mode)
    if kind == "other":
        raise Refused("not a file or folder")
    name = os.path.basename(path)
    parent = os.path.dirname(path)
    if kind == "folder":
        real = os.path.realpath(path)
        if target_real == real or target_real.startswith(real + os.sep):
            raise Refused("a folder cannot go inside itself")
    parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        # What the rename or copy acts on must still be what was looked at.
        now = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        if (now.st_dev, now.st_ino) != (st.st_dev, st.st_ino):
            raise Refused("changed while being delivered")
        parent_st = os.fstat(parent_fd)
        same_folder = (parent_st.st_dev, parent_st.st_ino) == (target_st.st_dev, target_st.st_ino)
        skipped = []
        if mode == "copy":
            dest = copy_entry(kind, parent_fd, name, target_fd, progress, skipped, (st.st_dev, st.st_ino))
        elif same_folder:
            return name, "already there"
        else:
            dest = None
            fallback = False
            for candidate in candidates(name, kind == "folder"):
                try:
                    rename_noreplace(parent_fd, name, target_fd, candidate)
                    dest = candidate
                    break
                except FileExistsError:
                    continue
                except OSError as error:
                    if error.errno in (18, 22, 95):  # EXDEV, EINVAL, EOPNOTSUPP: copy, then remove
                        fallback = True
                        break
                    raise
            if fallback:
                dest = copy_entry(kind, parent_fd, name, target_fd, progress, skipped, (st.st_dev, st.st_ino))
                again = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
                if (again.st_dev, again.st_ino) != (st.st_dev, st.st_ino):
                    return dest, "copied; the original changed meanwhile, so it was kept"
                if skipped:
                    return dest, "copied; the original was kept because some entries could not be copied"
                remove_entry(kind, parent_fd, name)
            elif dest is None:
                raise Refused("no free name in the target folder")
            else:
                progress.add(st.st_size if kind == "file" else 0)
        note = f"skipped {len(skipped)} special file(s)" if skipped else ""
        return dest, note
    finally:
        os.close(parent_fd)


def open_target(target):
    real = os.path.realpath(target)
    try:
        fd = os.open(real, DIR_FLAGS)
    except OSError as error:
        refuse(f"target folder: {error.strerror}")
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode):
        os.close(fd)
        refuse("target is not a folder")
    if st.st_uid != os.getuid():
        os.close(fd)
        refuse("target folder is not yours")
    return fd, real, st


def on_term(signum, frame):
    raise Cancelled()


def deliver():
    request = read_stdin_json()
    if not isinstance(request, dict):
        refuse("expected a JSON object")
    mode = request.get("mode")
    if mode not in ("copy", "move", "zip"):
        refuse("mode must be copy, move or zip")
    target = clean_path(request.get("target"))
    if target is None:
        refuse("target must be an absolute path")
    items = request.get("items")
    if not isinstance(items, list) or not items or len(items) > MAX_ITEMS:
        refuse(f"expected 1 to {MAX_ITEMS} items")
    paths = [clean_path(value) for value in items]

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    target_fd, target_real, target_st = open_target(target)
    ok = failed = 0
    try:
        total = 0
        for path in paths:
            size = tree_size(path) if path else 0
            if size < 0:
                total = -1
                break
            total += size
        progress = Progress(total)
        emit({"type": "start", "items": len(paths), "total": total, "target": target_real})
        if mode == "zip":
            # An item is only zipped once the archive is complete: progress
            # and failures go out as they happen, the per-item "ok" lines are
            # held until deliver_zip returns. A stop removes the partial
            # archive and reports nothing as zipped.
            held = []

            def report(line):
                if line.get("type") == "item" and line.get("ok"):
                    held.append(line)
                else:
                    emit(line)

            ok, failed, _ = deliver_zip(paths, target_fd, progress, report=report)
            for line in held:
                emit(line)
            paths = []
        for index, path in enumerate(paths):
            emit({"type": "begin", "i": index})
            if path is None:
                emit({"type": "item", "i": index, "ok": False, "error": "not a plain path"})
                failed += 1
                continue
            try:
                dest, note = deliver_one(path, mode, target_fd, target_real, target_st, progress)
            except Refused as why:
                emit({"type": "item", "i": index, "path": path, "ok": False, "error": str(why)})
                failed += 1
                continue
            except OSError as error:
                emit({"type": "item", "i": index, "path": path, "ok": False, "error": error.strerror or "error"})
                failed += 1
                continue
            emit({"type": "item", "i": index, "path": path, "ok": True, "dest": dest, "note": note})
            ok += 1
        emit({"type": "progress", "bytes": progress.done, "total": total})
        emit({"type": "done", "ok": ok, "failed": failed})
    except Refused as why:
        emit({"type": "done", "ok": 0, "failed": len(paths), "error": str(why)})
    except Cancelled:
        try:
            emit({"type": "cancelled", "ok": ok, "failed": failed})
        except OSError:
            pass
        return 130
    finally:
        os.close(target_fd)
    return 0


# ---- zip --------------------------------------------------------------------

def zip_time(mtime):
    t = time.localtime(max(mtime, 315532800))  # zip cannot store dates before 1980
    return t[:6]


def zip_add_file(zf, dir_fd, name, arcname, progress, expect=None):
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dir_fd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Refused("not a regular file")
        same_file(st, expect)
        info = zipfile.ZipInfo(arcname, zip_time(st.st_mtime))
        info.external_attr = (stat.S_IMODE(st.st_mode) | stat.S_IFREG) << 16
        info.compress_type = zipfile.ZIP_DEFLATED
        with zf.open(info, "w", force_zip64=True) as out:
            while True:
                chunk = os.read(fd, CHUNK)
                if not chunk:
                    break
                out.write(chunk)
                progress.add(len(chunk))
    finally:
        os.close(fd)


def zip_add_dir_entry(zf, arcname, st):
    info = zipfile.ZipInfo(arcname.rstrip("/") + "/", zip_time(st.st_mtime))
    info.external_attr = (stat.S_IMODE(st.st_mode) | stat.S_IFDIR) << 16 | 0x10
    zf.writestr(info, b"")


def zip_add_tree(zf, dir_fd, arcname, progress, skipped, depth):
    if depth > MAX_DEPTH:
        raise Refused("folders nested too deep")
    zip_add_dir_entry(zf, arcname, os.fstat(dir_fd))
    with os.scandir(dir_fd) as entries:
        listing = sorted(entries, key=lambda e: e.name)
    for entry in listing:
        st = entry.stat(follow_symlinks=False)
        child = f"{arcname}/{entry.name}"
        if stat.S_ISREG(st.st_mode):
            zip_add_file(zf, dir_fd, entry.name, child, progress, (st.st_dev, st.st_ino))
        elif stat.S_ISDIR(st.st_mode):
            sub = os.open(entry.name, DIR_FLAGS, dir_fd=dir_fd)
            try:
                same_file(os.fstat(sub), (st.st_dev, st.st_ino))
                zip_add_tree(zf, sub, child, progress, skipped, depth + 1)
            finally:
                os.close(sub)
        else:
            skipped.append(entry.name)


def archive_name(paths):
    """One item: named after it. Several: this machine and the time,
    e.g. laptop-2026-10-06-12-45-30.zip (no colons, which other systems refuse)."""
    if len(paths) == 1 and paths[0]:
        return os.path.basename(paths[0]) + ".zip"
    host = re.sub(r"[^A-Za-z0-9_-]", "", socket.gethostname().split(".")[0])[:40] or "archive"
    return f"{host}-{time.strftime('%Y-%m-%d-%H-%M-%S')}.zip"


def deliver_zip(paths, target_fd, progress, report=emit):
    """Pack every item into one new archive; returns (ok, failed, name).

    Per-item lines go through `report`, so a caller that still has to send
    the archive somewhere can hold them back until it knows the outcome."""
    base = archive_name(paths)
    fd = None
    for candidate in candidates(base, False):
        try:
            fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                         0o600, dir_fd=target_fd)
            break
        except FileExistsError:
            continue
    if fd is None:
        raise Refused("no free name in the target folder")
    ok = failed = 0
    used = set()
    try:
        with os.fdopen(fd, "wb") as handle:
            with zipfile.ZipFile(handle, "w", zipfile.ZIP_DEFLATED, allowZip64=True) as zf:
                for index, path in enumerate(paths):
                    report({"type": "begin", "i": index})
                    if path is None:
                        report({"type": "item", "i": index, "ok": False, "error": "not a plain path"})
                        failed += 1
                        continue
                    try:
                        st = os.lstat(path)
                        name = os.path.basename(path)
                        arc = next(c for c in candidates(name, stat.S_ISDIR(st.st_mode)) if c not in used)
                        used.add(arc)
                        skipped = []
                        parent_fd = os.open(os.path.dirname(path), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
                        try:
                            if stat.S_ISREG(st.st_mode):
                                zip_add_file(zf, parent_fd, name, arc, progress, (st.st_dev, st.st_ino))
                            elif stat.S_ISDIR(st.st_mode):
                                sub = os.open(name, DIR_FLAGS, dir_fd=parent_fd)
                                try:
                                    same_file(os.fstat(sub), (st.st_dev, st.st_ino))
                                    zip_add_tree(zf, sub, arc, progress, skipped, 1)
                                finally:
                                    os.close(sub)
                            else:
                                raise Refused("links and special files cannot go in a zip")
                        finally:
                            os.close(parent_fd)
                    except FileNotFoundError:
                        report({"type": "item", "i": index, "path": path, "ok": False, "error": "no longer there"})
                        failed += 1
                        continue
                    except Refused as why:
                        report({"type": "item", "i": index, "path": path, "ok": False, "error": str(why)})
                        failed += 1
                        continue
                    except OSError as error:
                        report({"type": "item", "i": index, "path": path, "ok": False, "error": error.strerror or "error"})
                        failed += 1
                        continue
                    note = f"skipped {len(skipped)} link(s) or special file(s)" if skipped else ""
                    report({"type": "item", "i": index, "path": path, "ok": True, "dest": candidate, "note": note})
                    ok += 1
            os.fchmod(handle.fileno(), 0o644)
        if ok == 0:
            os.unlink(candidate, dir_fd=target_fd)
    except BaseException:
        try:
            os.unlink(candidate, dir_fd=target_fd)
        except OSError:
            pass
        raise
    return ok, failed, candidate


# ---- send over SSH -----------------------------------------------------------

HOST_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$")
MAX_DIR = 1024
SSH_TIMEOUT = 15

# Runs on the host as `sh -c SCRIPT dropzone`. It takes no values from us
# except over stdin: the folder on the first line, then a tar stream whose
# top level is one numbered folder per item.
REMOTE_SCRIPT = r"""
IFS= read -r dir || exit 2
case $dir in "~") dir=$HOME ;; "~/"*) dir=$HOME/${dir#"~/"} ;; esac
if [ ! -d "$dir" ]; then echo "error no-folder"; cat >/dev/null; exit 3; fi
if [ ! -w "$dir" ]; then echo "error not-writable"; cat >/dev/null; exit 3; fi
if [ ! -O "$dir" ]; then echo "error not-yours"; cat >/dev/null; exit 3; fi
if [ -n "$(find "$dir" -prune "(" -perm -0002 -o -perm -0020 ")" -print 2>/dev/null)" ]; then echo "error shared"; cat >/dev/null; exit 3; fi
t=$(mktemp -d "$dir/.dropzone.XXXXXX") || { echo "error no-temp"; cat >/dev/null; exit 3; }
cleanup() { rm -rf "$t"; }
trap cleanup EXIT
trap "exit 1" HUP INT TERM
tar -xf - -C "$t" || { echo "error unpack"; exit 4; }
i=0
while [ -d "$t/$i" ]; do
  placed=0
  for src in "$t/$i"/* "$t/$i"/.[!.]* "$t/$i"/..?*; do
    [ -e "$src" ] || [ -L "$src" ] || continue
    name=${src##*/}
    stem=$name; ext=
    if [ ! -d "$src" ]; then
      case $name in
        ?*.tar.gz|?*.tar.bz2|?*.tar.xz|?*.tar.zst) ext=.tar.${name##*.tar.}; stem=${name%.tar.*} ;;
        ?*.*) ext=.${name##*.}; stem=${name%.*} ;;
      esac
    fi
    cand=$name; n=1
    while [ -e "$dir/$cand" ] || [ -L "$dir/$cand" ]; do
      n=$((n + 1)); [ "$n" -gt 1000 ] && break
      cand="$stem ($n)$ext"
    done
    if mv -n "$src" "$dir/$cand" 2>/dev/null && [ ! -e "$src" ] && [ ! -L "$src" ]; then
      printf "ok %s %s" "$i" "$cand"; echo; placed=1
    fi
  done
  [ "$placed" = 1 ] || echo "fail $i"
  i=$((i + 1))
done
echo done
"""

assert "'" not in REMOTE_SCRIPT and "\\" not in REMOTE_SCRIPT

REMOTE_ERRORS = {
    "no-folder": "no such folder on the host",
    "not-writable": "the folder on the host is not writable",
    "no-temp": "could not make a temporary folder on the host",
    "unpack": "the host could not unpack the transfer",
    "not-yours": "the folder on the host is not yours",
    "shared": "the folder on the host is writable by others; pick one only you can write to",
}


class CountingWriter:
    def __init__(self, raw, progress):
        self.raw = raw
        self.progress = progress

    def write(self, data):
        self.raw.write(data)
        self.progress.add(len(data))
        return len(data)

    def flush(self):
        self.raw.flush()


def drain(stream, keep, limit):
    for chunk in iter(lambda: stream.read(4096), b""):
        if sum(len(c) for c in keep) < limit:
            keep.append(chunk)


ANSI_RE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b[@-_]")
NO_SHELL_RE = re.compile(r"(?i)(term .sh. is not recognized|.sh. is not recognized|sh: (command )?not found|CommandNotFoundException)")


def clean_message(text):
    """Printable text from a remote program: no colour codes, no controls."""
    text = ANSI_RE.sub("", text)
    return "".join(ch for ch in text if ch == "\n" or (ch.isprintable() and ch != "\x7f"))


def remote_complaint(stderr_text, returncode):
    text = clean_message(stderr_text)
    if NO_SHELL_RE.search(text):
        return "the host has no Unix shell (Windows?); Drop Zone needs sh, tar and mv there"
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    for line in lines:
        if line.lower().startswith("ssh:"):
            return line[:200]
    return (lines[0] if lines else f"ssh exited with status {returncode}")[:200]


def tar_info(arcname, st, kind):
    info = tarfile.TarInfo(arcname)
    info.mode = stat.S_IMODE(st.st_mode)
    info.mtime = int(st.st_mtime)
    info.uid = info.gid = 0
    info.uname = info.gname = ""
    info.type = kind
    return info


def tar_add_entry(tar, dir_fd, name, arcname, skipped, depth, expect=None):
    """Add `name` (relative to the open `dir_fd`) to the stream.

    Nothing is reopened by path: a file is opened with O_NOFOLLOW relative to
    the descriptor of the folder it sits in and read through that descriptor,
    a folder likewise, and fstat decides what it is. A link is stored as a
    link, never followed. `expect` is the (st_dev, st_ino) of the staged item
    as it was looked at; anything else found under the name is refused."""
    if depth > MAX_DEPTH:
        raise Refused("folders nested too deep")
    st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
    if expect is not None and (st.st_dev, st.st_ino) != expect:
        raise Refused("changed while being sent")
    if stat.S_ISLNK(st.st_mode):
        info = tar_info(arcname, st, tarfile.SYMTYPE)
        info.linkname = os.readlink(name, dir_fd=dir_fd)
        tar.addfile(info)
    elif stat.S_ISREG(st.st_mode):
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dir_fd)
        with os.fdopen(fd, "rb") as handle:
            fst = os.fstat(fd)
            if not stat.S_ISREG(fst.st_mode) or (fst.st_dev, fst.st_ino) != (st.st_dev, st.st_ino):
                raise Refused("changed while being sent")
            info = tar_info(arcname, fst, tarfile.REGTYPE)
            info.size = fst.st_size
            tar.addfile(info, handle)
    elif stat.S_ISDIR(st.st_mode):
        sub = os.open(name, DIR_FLAGS, dir_fd=dir_fd)
        try:
            fst = os.fstat(sub)
            if (fst.st_dev, fst.st_ino) != (st.st_dev, st.st_ino):
                raise Refused("changed while being sent")
            tar.addfile(tar_info(arcname, fst, tarfile.DIRTYPE))
            with os.scandir(sub) as entries:
                names = sorted(entry.name for entry in entries)
            for child in names:
                tar_add_entry(tar, sub, child, f"{arcname}/{child}", skipped, depth + 1)
        finally:
            os.close(sub)
    else:
        skipped.append(arcname)


def ssh_transfer(host, folder, entries, progress):
    """Send `entries` [(index, path, (st_dev, st_ino))] into `folder` on `host`.

    Returns (placed {index: name}, skipped {index: bool}, error text)."""
    # ssh hands the words below to the login shell on the host, which may be
    # sh, bash, zsh or fish; a single-quoted script with no quotes or
    # backslashes inside reads the same in all of them.
    command = ["ssh", "-T", "-o", "BatchMode=yes", "-o", f"ConnectTimeout={SSH_TIMEOUT}",
               "--", host, "sh", "-c", "'" + REMOTE_SCRIPT + "'", "dropzone"]
    proc = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            close_fds=True)
    out_chunks, err_chunks = [], []
    readers = [threading.Thread(target=drain, args=(proc.stdout, out_chunks, 1 << 20), daemon=True),
               threading.Thread(target=drain, args=(proc.stderr, err_chunks, 8192), daemon=True)]
    for reader in readers:
        reader.start()
    skipped_any = {}
    try:
        try:
            proc.stdin.write(folder.encode("utf-8") + b"\n")
            writer = CountingWriter(proc.stdin, progress)
            with tarfile.open(fileobj=writer, mode="w|", format=tarfile.PAX_FORMAT) as tar:
                for index, path, expect in entries:
                    emit({"type": "begin", "i": index})
                    skipped = []
                    parent_fd = os.open(os.path.dirname(path), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
                    try:
                        tar_add_entry(tar, parent_fd, os.path.basename(path), f"{index}/{os.path.basename(path)}",
                                      skipped, 0, expect)
                    finally:
                        os.close(parent_fd)
                    skipped_any[index] = bool(skipped)
            proc.stdin.close()
        except BrokenPipeError:
            pass
        except (Refused, OSError) as why:
            # The stream is cut short, so the host unpacks nothing; say why.
            proc.terminate()
            proc.wait()
            for reader in readers:
                reader.join(timeout=5)
            message = str(why) if isinstance(why, Refused) else (why.strerror or "could not read a file")
            return {}, skipped_any, message
        try:
            proc.wait(timeout=600)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
    except BaseException:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
        raise
    for reader in readers:
        reader.join(timeout=5)

    placed, error, finished = {}, "", False
    for line in b"".join(out_chunks).decode("utf-8", "replace").splitlines():
        parts = line.split(" ", 2)
        if parts[0] == "ok" and len(parts) == 3 and parts[1].isdigit():
            placed[int(parts[1])] = clean_message(parts[2])[:255]
        elif parts[0] == "error" and len(parts) >= 2:
            error = REMOTE_ERRORS.get(parts[1].strip(), "the host refused the transfer")
        elif parts[0] == "done":
            finished = True
    if not finished and not error:
        error = remote_complaint(b"".join(err_chunks).decode("utf-8", "replace"), proc.returncode)
    return placed, skipped_any, error


def private_temp_dir():
    """A fresh 0700 folder under ~/.cache/dropshelf, as (parent fd, name)."""
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    home = os.path.realpath(os.path.expanduser("~"))
    if not os.path.abspath(cache).startswith(home + os.sep):
        cache = os.path.join(home, ".cache")
    parent = open_state_dir(os.path.join(cache, "dropshelf"))
    # A run killed outright (the hour limit, a crash) leaves its folder
    # behind with copies of the staged files; clear any older than two hours.
    try:
        with os.scandir(parent) as entries:
            stale = [e.name for e in entries if e.name.startswith("zip-")
                     and e.is_dir(follow_symlinks=False)
                     and time.time() - e.stat(follow_symlinks=False).st_mtime > 7200]
        for old in stale:
            shutil.rmtree(old, dir_fd=parent)
    except OSError:
        pass
    name = f"zip-{secrets.token_hex(8)}"
    os.mkdir(name, 0o700, dir_fd=parent)
    return parent, name


def send():
    request = read_stdin_json()
    if not isinstance(request, dict):
        refuse("expected a JSON object")
    mode = request.get("mode")
    if mode not in ("copy", "move", "zip"):
        refuse("mode must be copy, move or zip")
    host = request.get("host")
    if not isinstance(host, str) or not HOST_RE.match(host):
        refuse("host must be a plain SSH alias")
    folder = request.get("dir")
    if not isinstance(folder, str) or not folder or len(folder) > MAX_DIR or "\n" in folder or "\0" in folder:
        refuse("folder must be one line")
    items = request.get("items")
    if not isinstance(items, list) or not items or len(items) > MAX_ITEMS:
        refuse(f"expected 1 to {MAX_ITEMS} items")
    paths = [clean_path(value) for value in items]

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    if mode == "zip":
        return send_zip(host, folder, paths)

    # Look first: what is sent, and what a move may later remove, is this.
    sent = {}
    failed = ok = 0
    for index, path in enumerate(paths):
        try:
            if path is None:
                raise Refused("not a plain path")
            st = os.lstat(path)
            if kind_of(st.st_mode) == "other":
                raise Refused("not a file or folder")
            sent[index] = (path, st)
        except FileNotFoundError:
            emit({"type": "item", "i": index, "path": path or "", "ok": False, "error": "no longer there"})
            failed += 1
        except Refused as why:
            emit({"type": "item", "i": index, "path": path or "", "ok": False, "error": str(why)})
            failed += 1
    if not sent:
        emit({"type": "done", "ok": 0, "failed": failed})
        return 0

    total = 0
    for path, _ in sent.values():
        size = tree_size(path)
        if size < 0:
            total = -1
            break
        total += size
    progress = Progress(total)
    emit({"type": "start", "items": len(paths), "total": total, "target": f"{host}:{folder}"})
    try:
        entries = [(i, p, (st.st_dev, st.st_ino)) for i, (p, st) in sent.items()]
        placed, skipped_any, remote_error = ssh_transfer(host, folder, entries, progress)
    except Cancelled:
        try:
            emit({"type": "cancelled", "ok": 0, "failed": failed})
        except OSError:
            pass
        return 130

    for index, (path, st) in sent.items():
        if index not in placed:
            emit({"type": "item", "i": index, "path": path, "ok": False, "error": remote_error or "not placed on the host"})
            failed += 1
            continue
        note = ""
        if mode == "move":
            try:
                now = os.lstat(path)
                if (now.st_dev, now.st_ino) != (st.st_dev, st.st_ino):
                    note = "sent; the original changed meanwhile, so it was kept"
                elif skipped_any.get(index):
                    note = "sent; the original was kept because some entries could not be sent"
                else:
                    parent_fd = os.open(os.path.dirname(path), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
                    try:
                        remove_entry(kind_of(st.st_mode), parent_fd, os.path.basename(path))
                    finally:
                        os.close(parent_fd)
            except OSError as error:
                note = f"sent; the original could not be removed ({error.strerror})"
        elif skipped_any.get(index):
            note = "skipped special files"
        emit({"type": "item", "i": index, "path": path, "ok": True, "dest": placed[index], "note": note})
        ok += 1
    emit({"type": "progress", "bytes": progress.done, "total": total})
    emit({"type": "done", "ok": ok, "failed": failed})
    return 0


def send_zip(host, folder, paths):
    """Zip into a private temporary folder here, send the one archive, remove it."""
    total = 0
    for path in paths:
        size = tree_size(path) if path else 0
        if size < 0:
            total = -1
            break
        total += size
    emit({"type": "start", "items": len(paths), "total": total, "target": f"{host}:{folder}"})
    held = []
    parent_fd, tmp_name = private_temp_dir()
    try:
        tmp_fd = os.open(tmp_name, DIR_FLAGS, dir_fd=parent_fd)
        try:
            try:
                zipped, failed, zip_name = deliver_zip(paths, tmp_fd, Progress(total), report=held.append)
            except Refused as why:
                emit({"type": "done", "ok": 0, "failed": len(paths), "error": str(why)})
                return 0
            for line in held:
                if line.get("type") == "begin":
                    emit(line)
                elif not line.get("ok"):
                    emit(line)
            if zipped == 0:
                emit({"type": "done", "ok": 0, "failed": failed})
                return 0
            zip_path = f"/proc/self/fd/{tmp_fd}/{zip_name}"
            zst = os.stat(zip_name, dir_fd=tmp_fd, follow_symlinks=False)
            size = zst.st_size
            progress = Progress(size)
            emit({"type": "start", "items": len(paths), "total": size, "target": f"{host}:{folder}"})
            placed, _, remote_error = ssh_transfer(host, folder, [(0, zip_path, (zst.st_dev, zst.st_ino))], progress)
        finally:
            os.close(tmp_fd)
        ok = 0
        for line in held:
            if line.get("type") != "item" or not line.get("ok"):
                continue
            if 0 in placed:
                line = dict(line, dest=placed[0])
                emit(line)
                ok += 1
            else:
                emit(dict(line, ok=False, error=remote_error or "not placed on the host", dest=""))
                failed += 1
        emit({"type": "progress", "bytes": progress.done, "total": progress.total})
        emit({"type": "done", "ok": ok, "failed": failed})
        return 0
    except Cancelled:
        try:
            emit({"type": "cancelled", "ok": 0, "failed": 0})
        except OSError:
            pass
        return 130
    finally:
        try:
            shutil.rmtree(tmp_name, dir_fd=parent_fd)
        except OSError:
            pass
        os.close(parent_fd)


# ---- hosts -------------------------------------------------------------------

MAX_CONFIG_BYTES = 256 * 1024


def read_config(path, budget):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return ""
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return ""
        with os.fdopen(fd, "rb", closefd=False) as handle:
            return handle.read(max(0, budget)).decode("utf-8", "replace")
    finally:
        os.close(fd)


def hosts():
    ssh_dir = os.path.expanduser("~/.ssh")
    found, git_only = [], set()
    budget = [MAX_CONFIG_BYTES]

    def walk(path, depth):
        text = read_config(path, budget[0])
        budget[0] -= len(text)
        block = []
        for raw in text.splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            key, _, value = line.replace("=", " ", 1).partition(" ")
            key, value = key.lower(), value.strip()
            if key == "host":
                block = [h for h in value.split() if HOST_RE.match(h)]
                for h in block:
                    if h not in found:
                        found.append(h)
            elif key == "match":
                block = []
            elif key == "user" and value == "git":
                git_only.update(block)
            elif key == "include" and depth < 3:
                for pattern in value.split():
                    pattern = os.path.expanduser(pattern)
                    if not os.path.isabs(pattern):
                        pattern = os.path.join(ssh_dir, pattern)
                    for included in sorted(glob.glob(pattern))[:32]:
                        walk(included, depth + 1)

    walk(os.path.join(ssh_dir, "config"), 0)
    sys.stdout.write(json.dumps([h for h in found if h not in git_only][:64]) + "\n")
    return 0


# ---- open-folder ---------------------------------------------------------------

def open_folder():
    request = read_stdin_json(64 * 1024)
    folder = clean_path(request.get("folder") if isinstance(request, dict) else None)
    if folder is None or not os.path.isdir(folder):
        refuse("not a folder")
    names = request.get("items") if isinstance(request.get("items"), list) else []
    picked = [os.path.join(folder, n) for n in names[:50] if isinstance(n, str) and n and "/" not in n and n not in (".", "..")]
    picked = [p for p in picked if os.path.lexists(p)]
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    uri = lambda p: Gio.File.new_for_path(p).get_uri()
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        method, uris = ("ShowItems", [uri(p) for p in picked]) if picked else ("ShowFolders", [uri(folder)])
        bus.call_sync("org.freedesktop.FileManager1", "/org/freedesktop/FileManager1", "org.freedesktop.FileManager1",
                      method, GLib.Variant("(ass)", (uris, "")), None, Gio.DBusCallFlags.NONE, 5000, None)
    except GLib.Error:
        Gio.AppInfo.launch_default_for_uri(uri(folder), None)
    return 0


def main(argv):
    if len(argv) == 4 and argv[1] == "state" and argv[2] == "read":
        return state_read(os.path.abspath(argv[3]))
    if len(argv) == 4 and argv[1] == "state" and argv[2] == "write":
        return state_write(os.path.abspath(argv[3]))
    if len(argv) == 2 and argv[1] == "inspect":
        return inspect()
    if len(argv) == 2 and argv[1] == "deliver":
        return deliver()
    if len(argv) == 2 and argv[1] == "send":
        return send()
    if len(argv) == 2 and argv[1] == "hosts":
        return hosts()
    if len(argv) == 2 and argv[1] == "open-folder":
        return open_folder()
    print(f"usage: {NAME} state read|write <file> | inspect | deliver | send | hosts | open-folder  (data on stdin)",
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
